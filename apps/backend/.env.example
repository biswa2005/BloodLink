# Optional override; falls back to packages/db/.env
# DATABASE_URL=postgresql://bloodlink:bloodlink@localhost:5432/bloodlink

# Required. Minimum 16 characters. Do not commit real secrets.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Required. HMAC key for QR arrival tokens + donor response links. Min 16 chars.
QR_SECRET=dev-only-qr-secret-change-me-0123456789

# Access token lifetime (jsonwebtoken `expiresIn` syntax)
JWT_EXPIRES_IN=24h

PORT=3000

# Base URL used in WhatsApp accept/deny links
PUBLIC_BASE_URL=http://localhost:3000

# Matching waves
WAVE_FALLBACK_DELAY_MINUTES=5
WAVE_SIZE=10

# Background jobs
NO_SHOW_GRACE_MINUTES=120
STALE_PING_SECONDS=90

# Whole-blood donation cooldown: a donor is ineligible until this many days
# after their last donation (84 days = 12 weeks, standard deferral window)
DONATION_COOLDOWN_DAYS=84

# Donor response link lifetime
ACTION_LINK_TTL_MINUTES=720

# WhatsApp donor alerts (whatsapp-web.js); false logs messages to console only
WHATSAPP_ENABLED=true

# Optional: system Chrome/Edge for whatsapp-web.js puppeteer
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
